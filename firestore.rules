rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function aclOwner(documentId) {
      return signedIn() && (
        (
          exists(/databases/$(database)/documents/storage_acl/$(documentId))
          && get(/databases/$(database)/documents/storage_acl/$(documentId)).data.owner_uid
            == request.auth.uid
        )
        || (
          existsAfter(/databases/$(database)/documents/storage_acl/$(documentId))
          && getAfter(/databases/$(database)/documents/storage_acl/$(documentId)).data.owner_uid
            == request.auth.uid
        )
      );
    }

    match /storage_acl/{documentId} {
      allow create: if signedIn()
        && request.resource.data.owner_uid == request.auth.uid;
      allow read, delete: if signedIn()
        && resource.data.owner_uid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.owner_uid == request.auth.uid
        && request.resource.data.owner_uid == request.auth.uid;

      match /readers/{readerUid} {
        allow get: if signedIn()
          && (request.auth.uid == readerUid || aclOwner(documentId));
        allow list: if aclOwner(documentId);
        allow create, update: if aclOwner(documentId)
          && request.resource.data.uid == readerUid;
        allow delete: if aclOwner(documentId);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
